{
	"name": "@dorsk/hmm",
	"version": "0.4.0",
	"description": "Feedback panel for Svelte apps built on tsumikit: select an element, comment, attach a screenshot, review what will be sent, and post it to your own endpoint.",
	"type": "module",
	"license": "MIT",
	"author": "Dorsk <dorsk.dev@gmail.com>",
	"homepage": "https://github.com/DorskFR/hmm",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DorskFR/hmm.git"
	},
	"bugs": {
		"url": "https://github.com/DorskFR/hmm/issues"
	},
	"keywords": [
		"feedback",
		"widget",
		"screenshot",
		"picker",
		"bug-report",
		"svelte",
		"svelte5",
		"tsumikit"
	],
	"files": [
		"dist",
		"schema"
	],
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./envelope": {
			"types": "./dist/envelope.d.ts",
			"default": "./dist/envelope.js"
		},
		"./standalone": "./dist/standalone/hmm.js",
		"./scoped.css": "./dist/standalone/hmm.css",
		"./schema/envelope.v1.json": "./schema/envelope.v1.json",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "node scripts/version.mjs && svelte-package -i src -o dist && node scripts/bundle.mjs && publint",
		"check": "node scripts/version.mjs && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check . && tsumikit-lint src",
		"format": "biome check --write .",
		"demo": "npm run build && node demo/serve.mjs 4188",
		"test": "npm run build && playwright test",
		"test:unit": "playwright test --project unit",
		"prepare": "lefthook install || true",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"modern-screenshot": "^4.7.0"
	},
	"peerDependencies": {
		"@dorsk/tsumikit": ">=0.82.0 <1",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@dorsk/tsumikit": "^0.83.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/package": "^3.0.2",
		"@types/node": "^26.4.1",
		"ajv": "^8.17.1",
		"esbuild": "^0.28.2",
		"esbuild-svelte": "^0.9.5",
		"lefthook": "^2.1.12",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3"
	},
	"svelte": "./dist/index.js",
	"sideEffects": false
}
